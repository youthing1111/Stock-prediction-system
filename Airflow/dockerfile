FROM apache/airflow:3.0.0

USER root
RUN apt-get -y update && \
    apt-get -y install --no-install-recommends python3-dev libhdf5-dev default-libmysqlclient-dev \
        build-essential pkg-config openjdk-17-jdk-headless && \
    ln -s "/usr/lib/jvm/java-17-openjdk-$(dpkg --print-architecture)" /usr/lib/jvm/java-17 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*
# Architecture-independent path (works on arm64 and amd64)
ENV JAVA_HOME=/usr/lib/jvm/java-17

USER airflow
COPY requirements.txt /requirements.txt
COPY constraints.txt /constraints.txt
RUN pip install --no-cache-dir -r /requirements.txt -c /constraints.txt
