AIRFLOW_UID=501
#docker compose --env-file config.env up -d --build

# Postgres configuration
PG_USER=airflow
PG_PASSWORD=change-me
PG_DATABASE=stock
PG_PORT=5434

# MLflow configuration
MLFLOW_PORT=5005
MLFLOW_BUCKET_NAME=mlflow-artifacts

# MinIO access keys (create in MinIO console) - needed by MLflow
MINIO_ACCESS_KEY=
MINIO_SECRET_ACCESS_KEY=

# MinIO configuration (env files require KEY=value)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_ADDRESS=:9005
MINIO_STORAGE_USE_HTTPS=False
MINIO_CONSOLE_ADDRESS=:9006
MINIO_PORT=9005
MINIO_CONSOLE_PORT=9006

# GitHub fine-grained token: contents:write on StockPredict.github.io only
GITHUB_TOKEN=

# Airflow API JWT signing secret: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
AIRFLOW_JWT_SECRET=

# Airflow Fernet key (encrypts connection passwords). Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a copy safe: losing it makes stored connections unreadable.
AIRFLOW_FERNET_KEY=
